{
  "name": "money-machine",
  "version": "1.2.0",
  "description": "A legal, automation-first catalog and toolkit of 100+ ways to get paid online, ranked by probability of payment, automation and effort.",
  "type": "module",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "bin": {
    "formal-ai": "formal-ai/bin/formal-ai.mjs"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "scripts": {
    "test": "node --test tests/",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:file-size": "node scripts/check-file-size.mjs",
    "check": "npm run lint && npm run format:check && npm run check:file-size && npm run check:catalog",
    "prepare": "husky || true",
    "changeset": "changeset",
    "changeset:version": "node scripts/changeset-version.mjs",
    "changeset:publish": "changeset publish",
    "changeset:status": "changeset status --since=origin/main",
    "build:catalog": "node scripts/build-catalog.mjs",
    "website": "npm run build:catalog && npx --yes serve website",
    "check:catalog": "node scripts/build-catalog.mjs && git diff --quiet -- data/strategies.json docs/business-plans docs/legal/incorporation-costs.md || (echo \"Catalog out of date: run npm run build:catalog and commit\" && exit 1)",
    "formal-ai": "node formal-ai/bin/formal-ai.mjs",
    "formal-ai:site": "node formal-ai/scripts/translate-site.mjs",
    "website:ru": "node scripts/build-website.mjs --lang=ru",
    "formal-ai:record": "node formal-ai/scripts/record-fixtures.mjs"
  },
  "keywords": [
    "money",
    "income",
    "automation",
    "business-plans",
    "side-income",
    "passive-income",
    "freelancing",
    "affiliate",
    "open-source"
  ],
  "author": "",
  "license": "Unlicense",
  "repository": {
    "type": "git",
    "url": "https://github.com/konard/money-machine"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.6",
    "marked": "^15.0.12",
    "prettier": "^3.6.2",
    "test-anywhere": "^0.8.48"
  },
  "lint-staged": {
    "*.{js,mjs,cjs}": [
      "eslint --fix --max-warnings 0",
      "prettier --write",
      "prettier --check"
    ],
    "*.md": [
      "prettier --write",
      "prettier --check"
    ]
  },
  "homepage": "https://konard.github.io/money-machine/"
}
