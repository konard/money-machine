# Corrections of public data (generated by scripts/overrides.mjs from the
# reference vocabulary, then reviewed). An override concept replaces what
# Wiktionary/Wikidata say about its word; every other word is learned from
# public data while the translator runs.

# public data: глядеть, выглядеть, искать, надеяться, ожидать
concept look
  class perception
  en verb look
  en takes at
  ru verb смотреть perf:посмотреть pres:смотрю,смотришь perf-pres:посмотрю,посмотришь gov:на+acc

# public data: желать, нуждаться
concept want
  class desire
  en verb want
  ru verb хотеть pres:хочу,хочешь,хочет,хотим,хотите,хотят

# public data: бегать, течь, управлять, идти, вести
concept run.move
  gloss "move fast on foot"
  class motion
  en verb run ran run
  ru verb бегать perf:побежать perf-pres:побегу,побежишь,побежит,побежим,побежите,побегут motion
  cues fast park morning every race marathon quickly away

# public data: бегать, течь, управлять, идти, вести
concept run.manage
