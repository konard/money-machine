# Corrections of public data (generated by scripts/overrides.mjs from the
# reference vocabulary, then reviewed). An override concept replaces what
# Wiktionary/Wikidata say about its word; every other word is learned from
# public data while the translator runs.

# public data: твёрдый, тяжёлый, крепкий, жёсткий, неопровержимый
concept difficult
  en adj difficult
  en adj hard
  ru adj трудный

# public data: поздно, после, потом
concept later
  en adv later
  ru adv позже

# public data: будьте добры
concept please
  en adv please
  ru adv пожалуйста

# public data: 
concept unchanged
  en adv unchanged
  ru adv без+изменений

# public data: Я знаю Москву.
concept moscow
  grounded-in Q649
  en name Moscow
  ru noun Москва f
  form sg.acc Москву

# public data: Я знаю юфть.
concept russia
  grounded-in Q159
  en name Russia
  ru noun Россия f

# public data: Хорошее утро.
concept good-morning
  en phrase good morning
  ru phrase "Доброе утро"

# public data: Хорошая ночь.
concept good-night
  en phrase good night
  ru phrase "Спокойной ночи"

# public data: Прощай.
concept goodbye
  en phrase goodbye
  en phrase bye
  ru phrase "До свидания"

# public data: Как-как.
concept sorry
  en phrase sorry
  en phrase i am sorry
  en phrase excuse me
  ru phrase Извините

# public data: the negator "never" is a closed-class word without a sense
concept never
  en adv never
  ru adv никогда neg

# public data: the sense "most recently" has no Russian translation on
# English or Russian Wiktionary (https://en.wiktionary.org/wiki/last#Adverb);
# the second sense keeps the public "after everything else" → после всех
concept last.recently
  gloss "most recently"
  en adv last
  ru adv в+последний+раз

concept last.finally
  gloss "after everything else; finally"
  en adv last
  ru adv после+всех
