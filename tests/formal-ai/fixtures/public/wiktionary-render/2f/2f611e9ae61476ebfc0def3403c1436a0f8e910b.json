{"parse":{"text":"<i class=\"Cyrl form-of lang-ru inf-form-of\">сма́тываться</i>\n<i class=\"Cyrl form-of lang-ru pres&#124;act&#124;part-form-of\">сма́тывающийся</i>\n<i class=\"Cyrl form-of lang-ru past&#124;act&#124;part-form-of\">сма́тывавшийся</i>\n<i class=\"Cyrl form-of lang-ru pres&#124;adv&#124;part-form-of\">сма́тываясь</i>\n<i class=\"Cyrl form-of lang-ru past&#124;adv&#124;part-form-of\">сма́тывавшись</i>\n<i class=\"Cyrl form-of lang-ru 1&#124;s&#124;pres&#124;ind-form-of\">сма́тываюсь</i>\n<i class=\"Cyrl form-of lang-ru 2&#124;s&#124;pres&#124;ind-form-of\">сма́тываешься</i>\n<i class=\"Cyrl form-of lang-ru 3&#124;s&#124;pres&#124;ind-form-of\">сма́тывается</i>\n<i class=\"Cyrl form-of lang-ru 1&#124;p&#124;pres&#124;ind-form-of\">сма́тываемся</i>\n<i class=\"Cyrl form-of lang-ru 2&#124;p&#124;pres&#124;ind-form-of\">сма́тываетесь</i>\n<i class=\"Cyrl form-of lang-ru 3&#124;p&#124;pres&#124;ind-form-of\">сма́тываются</i>\n<i class=\"Cyrl form-of lang-ru 2&#124;s&#124;imp-form-of\">сма́тывайся</i>\n<i class=\"Cyrl form-of lang-ru 2&#124;p&#124;imp-form-of\">сма́тывайтесь</i>\n<i class=\"Cyrl form-of lang-ru m&#124;s&#124;past&#124;ind-form-of\">сма́тывался</i>\n<i class=\"Cyrl form-of lang-ru p&#124;past&#124;ind-form-of\">сма́тывались</i>\n<i class=\"Cyrl form-of lang-ru f&#124;s&#124;past&#124;ind-form-of\">сма́тывалась</i>\n<i class=\"Cyrl form-of lang-ru n&#124;s&#124;past&#124;ind-form-of\">сма́тывалось</i>\n<abbr title=\"imperfective aspect\">\nindeclinable"}}