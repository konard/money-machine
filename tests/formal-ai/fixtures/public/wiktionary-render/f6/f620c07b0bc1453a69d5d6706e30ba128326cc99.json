{"parse":{"text":"<i class=\"Cyrl form-of lang-ru inf-form-of\">содержа́ть</i>\n<i class=\"Cyrl form-of lang-ru pres&#124;act&#124;part-form-of\">содержа́щий</i>\n<i class=\"Cyrl form-of lang-ru past&#124;act&#124;part-form-of\">содержа́вший</i>\n<i class=\"Cyrl form-of lang-ru pres&#124;pass&#124;part-form-of\">содержи́мый</i>\n<i class=\"Cyrl form-of lang-ru pres&#124;adv&#124;part-form-of\">содержа́</i>\n<i class=\"Cyrl form-of lang-ru past&#124;adv&#124;part-form-of\">содержа́в</i>\n<i class=\"Cyrl form-of lang-ru 1&#124;s&#124;pres&#124;ind-form-of\">содержу́</i>\n<i class=\"Cyrl form-of lang-ru 2&#124;s&#124;pres&#124;ind-form-of\">соде́ржишь</i>\n<i class=\"Cyrl form-of lang-ru 3&#124;s&#124;pres&#124;ind-form-of\">соде́ржит</i>\n<i class=\"Cyrl form-of lang-ru 1&#124;p&#124;pres&#124;ind-form-of\">соде́ржим</i>\n<i class=\"Cyrl form-of lang-ru 2&#124;p&#124;pres&#124;ind-form-of\">соде́ржите</i>\n<i class=\"Cyrl form-of lang-ru 3&#124;p&#124;pres&#124;ind-form-of\">соде́ржат</i>\n<i class=\"Cyrl form-of lang-ru 2&#124;s&#124;imp-form-of\">содержи́</i>\n<i class=\"Cyrl form-of lang-ru 2&#124;p&#124;imp-form-of\">содержи́те</i>\n<i class=\"Cyrl form-of lang-ru m&#124;s&#124;past&#124;ind-form-of\">содержа́л</i>\n<i class=\"Cyrl form-of lang-ru p&#124;past&#124;ind-form-of\">содержа́ли</i>\n<i class=\"Cyrl form-of lang-ru f&#124;s&#124;past&#124;ind-form-of\">содержа́ла</i>\n<i class=\"Cyrl form-of lang-ru n&#124;s&#124;past&#124;ind-form-of\">содержа́ло</i>\n<abbr title=\"imperfective aspect\">\nindeclinable"}}