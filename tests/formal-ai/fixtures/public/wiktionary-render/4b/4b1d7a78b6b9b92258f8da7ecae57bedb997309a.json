{"parse":{"text":"<i class=\"Cyrl form-of lang-ru diminutive-form-of\">репертуа́рчик</i>\n<i class=\"Cyrl form-of lang-ru nom&#124;s-form-of\">репертуа́р</i>\n<i class=\"Cyrl form-of lang-ru nom&#124;p-form-of\">репертуа́ры</i>\n<i class=\"Cyrl form-of lang-ru gen&#124;s-form-of\">репертуа́ра</i>\n<i class=\"Cyrl form-of lang-ru gen&#124;p-form-of\">репертуа́ров</i>\n<i class=\"Cyrl form-of lang-ru dat&#124;s-form-of\">репертуа́ру</i>\n<i class=\"Cyrl form-of lang-ru dat&#124;p-form-of\">репертуа́рам</i>\n<i class=\"Cyrl form-of lang-ru acc&#124;s-form-of\">репертуа́р</i>\n<i class=\"Cyrl form-of lang-ru acc&#124;p-form-of\">репертуа́ры</i>\n<i class=\"Cyrl form-of lang-ru ins&#124;s-form-of\">репертуа́ром</i>\n<i class=\"Cyrl form-of lang-ru ins&#124;p-form-of\">репертуа́рами</i>\n<i class=\"Cyrl form-of lang-ru pre&#124;s-form-of\">репертуа́ре</i>\n<i class=\"Cyrl form-of lang-ru pre&#124;p-form-of\">репертуа́рах</i>\n<abbr title=\"masculine gender\">\n<abbr title=\"inanimate\">\n<a title=\"Appendix:Russian nouns\">inan masc-form hard-stem accent-a</a>\n"}}