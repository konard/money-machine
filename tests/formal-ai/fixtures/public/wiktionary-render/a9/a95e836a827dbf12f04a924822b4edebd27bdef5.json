{"parse":{"text":"<i class=\"Cyrl form-of lang-ru inf-form-of\">съе́сть</i>\n<i class=\"Cyrl form-of lang-ru past&#124;act&#124;part-form-of\">съе́вший</i>\n<i class=\"Cyrl form-of lang-ru past&#124;pass&#124;part-form-of\">съе́денный</i>\n<i class=\"Cyrl form-of lang-ru past&#124;adv&#124;part-form-of\">съе́в</i>\n<i class=\"Cyrl form-of lang-ru 1&#124;s&#124;fut&#124;ind-form-of\">съе́м</i>\n<i class=\"Cyrl form-of lang-ru 2&#124;s&#124;fut&#124;ind-form-of\">съе́шь</i>\n<i class=\"Cyrl form-of lang-ru 3&#124;s&#124;fut&#124;ind-form-of\">съе́ст</i>\n<i class=\"Cyrl form-of lang-ru 1&#124;p&#124;fut&#124;ind-form-of\">съеди́м</i>\n<i class=\"Cyrl form-of lang-ru 2&#124;p&#124;fut&#124;ind-form-of\">съеди́те</i>\n<i class=\"Cyrl form-of lang-ru 3&#124;p&#124;fut&#124;ind-form-of\">съедя́т</i>\n<i class=\"Cyrl form-of lang-ru 2&#124;s&#124;imp-form-of\">съе́шь</i>\n<i class=\"Cyrl form-of lang-ru 2&#124;p&#124;imp-form-of\">съе́шьте</i>\n<i class=\"Cyrl form-of lang-ru m&#124;s&#124;past&#124;ind-form-of\">съе́л</i>\n<i class=\"Cyrl form-of lang-ru p&#124;past&#124;ind-form-of\">съе́ли</i>\n<i class=\"Cyrl form-of lang-ru f&#124;s&#124;past&#124;ind-form-of\">съе́ла</i>\n<i class=\"Cyrl form-of lang-ru n&#124;s&#124;past&#124;ind-form-of\">съе́ло</i>\n<abbr title=\"perfective aspect\">\nindeclinable"}}