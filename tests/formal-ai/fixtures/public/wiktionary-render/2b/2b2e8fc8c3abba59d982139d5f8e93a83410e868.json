{"parse":{"text":"<i class=\"Cyrl form-of lang-ru inf-form-of\">отправля́ться</i>\n<i class=\"Cyrl form-of lang-ru pres&#124;act&#124;part-form-of\">отправля́ющийся</i>\n<i class=\"Cyrl form-of lang-ru past&#124;act&#124;part-form-of\">отправля́вшийся</i>\n<i class=\"Cyrl form-of lang-ru pres&#124;adv&#124;part-form-of\">отправля́ясь</i>\n<i class=\"Cyrl form-of lang-ru past&#124;adv&#124;part-form-of\">отправля́вшись</i>\n<i class=\"Cyrl form-of lang-ru 1&#124;s&#124;pres&#124;ind-form-of\">отправля́юсь</i>\n<i class=\"Cyrl form-of lang-ru 2&#124;s&#124;pres&#124;ind-form-of\">отправля́ешься</i>\n<i class=\"Cyrl form-of lang-ru 3&#124;s&#124;pres&#124;ind-form-of\">отправля́ется</i>\n<i class=\"Cyrl form-of lang-ru 1&#124;p&#124;pres&#124;ind-form-of\">отправля́емся</i>\n<i class=\"Cyrl form-of lang-ru 2&#124;p&#124;pres&#124;ind-form-of\">отправля́етесь</i>\n<i class=\"Cyrl form-of lang-ru 3&#124;p&#124;pres&#124;ind-form-of\">отправля́ются</i>\n<i class=\"Cyrl form-of lang-ru 2&#124;s&#124;imp-form-of\">отправля́йся</i>\n<i class=\"Cyrl form-of lang-ru 2&#124;p&#124;imp-form-of\">отправля́йтесь</i>\n<i class=\"Cyrl form-of lang-ru m&#124;s&#124;past&#124;ind-form-of\">отправля́лся</i>\n<i class=\"Cyrl form-of lang-ru p&#124;past&#124;ind-form-of\">отправля́лись</i>\n<i class=\"Cyrl form-of lang-ru f&#124;s&#124;past&#124;ind-form-of\">отправля́лась</i>\n<i class=\"Cyrl form-of lang-ru n&#124;s&#124;past&#124;ind-form-of\">отправля́лось</i>\n<abbr title=\"imperfective aspect\">\nindeclinable"}}