{"parse":{"text":"<i class=\"Cyrl form-of lang-ru nom&#124;s-form-of\">во́зглас</i>\n<i class=\"Cyrl form-of lang-ru nom&#124;p-form-of\">во́згласы</i>\n<i class=\"Cyrl form-of lang-ru gen&#124;s-form-of\">во́згласа</i>\n<i class=\"Cyrl form-of lang-ru gen&#124;p-form-of\">во́згласов</i>\n<i class=\"Cyrl form-of lang-ru dat&#124;s-form-of\">во́згласу</i>\n<i class=\"Cyrl form-of lang-ru dat&#124;p-form-of\">во́згласам</i>\n<i class=\"Cyrl form-of lang-ru acc&#124;s-form-of\">во́зглас</i>\n<i class=\"Cyrl form-of lang-ru acc&#124;p-form-of\">во́згласы</i>\n<i class=\"Cyrl form-of lang-ru ins&#124;s-form-of\">во́згласом</i>\n<i class=\"Cyrl form-of lang-ru ins&#124;p-form-of\">во́згласами</i>\n<i class=\"Cyrl form-of lang-ru pre&#124;s-form-of\">во́згласе</i>\n<i class=\"Cyrl form-of lang-ru pre&#124;p-form-of\">во́згласах</i>\n<abbr title=\"masculine gender\">\n<abbr title=\"inanimate\">\n<a title=\"Appendix:Russian nouns\">inan masc-form hard-stem accent-a</a>\n"}}