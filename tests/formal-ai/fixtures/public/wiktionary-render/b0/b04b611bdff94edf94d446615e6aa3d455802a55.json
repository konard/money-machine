{"parse":{"text":"<i class=\"Cyrl form-of lang-ru inf-form-of\">реша́ться</i>\n<i class=\"Cyrl form-of lang-ru pres&#124;act&#124;part-form-of\">реша́ющийся</i>\n<i class=\"Cyrl form-of lang-ru past&#124;act&#124;part-form-of\">реша́вшийся</i>\n<i class=\"Cyrl form-of lang-ru pres&#124;adv&#124;part-form-of\">реша́ясь</i>\n<i class=\"Cyrl form-of lang-ru past&#124;adv&#124;part-form-of\">реша́вшись</i>\n<i class=\"Cyrl form-of lang-ru 1&#124;s&#124;pres&#124;ind-form-of\">реша́юсь</i>\n<i class=\"Cyrl form-of lang-ru 2&#124;s&#124;pres&#124;ind-form-of\">реша́ешься</i>\n<i class=\"Cyrl form-of lang-ru 3&#124;s&#124;pres&#124;ind-form-of\">реша́ется</i>\n<i class=\"Cyrl form-of lang-ru 1&#124;p&#124;pres&#124;ind-form-of\">реша́емся</i>\n<i class=\"Cyrl form-of lang-ru 2&#124;p&#124;pres&#124;ind-form-of\">реша́етесь</i>\n<i class=\"Cyrl form-of lang-ru 3&#124;p&#124;pres&#124;ind-form-of\">реша́ются</i>\n<i class=\"Cyrl form-of lang-ru 2&#124;s&#124;imp-form-of\">реша́йся</i>\n<i class=\"Cyrl form-of lang-ru 2&#124;p&#124;imp-form-of\">реша́йтесь</i>\n<i class=\"Cyrl form-of lang-ru m&#124;s&#124;past&#124;ind-form-of\">реша́лся</i>\n<i class=\"Cyrl form-of lang-ru p&#124;past&#124;ind-form-of\">реша́лись</i>\n<i class=\"Cyrl form-of lang-ru f&#124;s&#124;past&#124;ind-form-of\">реша́лась</i>\n<i class=\"Cyrl form-of lang-ru n&#124;s&#124;past&#124;ind-form-of\">реша́лось</i>\n<abbr title=\"imperfective aspect\">\nindeclinable"}}