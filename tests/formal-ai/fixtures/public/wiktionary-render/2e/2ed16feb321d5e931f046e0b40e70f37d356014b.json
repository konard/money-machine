{"parse":{"text":"<i class=\"Cyrl form-of lang-ru inf-form-of\">возрази́ть</i>\n<i class=\"Cyrl form-of lang-ru past&#124;act&#124;part-form-of\">возрази́вший</i>\n<i class=\"Cyrl form-of lang-ru past&#124;adv&#124;part-form-of\">возрази́в</i>\n<i class=\"Cyrl form-of lang-ru 1&#124;s&#124;fut&#124;ind-form-of\">возражу́</i>\n<i class=\"Cyrl form-of lang-ru 2&#124;s&#124;fut&#124;ind-form-of\">возрази́шь</i>\n<i class=\"Cyrl form-of lang-ru 3&#124;s&#124;fut&#124;ind-form-of\">возрази́т</i>\n<i class=\"Cyrl form-of lang-ru 1&#124;p&#124;fut&#124;ind-form-of\">возрази́м</i>\n<i class=\"Cyrl form-of lang-ru 2&#124;p&#124;fut&#124;ind-form-of\">возрази́те</i>\n<i class=\"Cyrl form-of lang-ru 3&#124;p&#124;fut&#124;ind-form-of\">возразя́т</i>\n<i class=\"Cyrl form-of lang-ru 2&#124;s&#124;imp-form-of\">возрази́</i>\n<i class=\"Cyrl form-of lang-ru 2&#124;p&#124;imp-form-of\">возрази́те</i>\n<i class=\"Cyrl form-of lang-ru m&#124;s&#124;past&#124;ind-form-of\">возрази́л</i>\n<i class=\"Cyrl form-of lang-ru p&#124;past&#124;ind-form-of\">возрази́ли</i>\n<i class=\"Cyrl form-of lang-ru f&#124;s&#124;past&#124;ind-form-of\">возрази́ла</i>\n<i class=\"Cyrl form-of lang-ru n&#124;s&#124;past&#124;ind-form-of\">возрази́ло</i>\n<abbr title=\"perfective aspect\">\nindeclinable"}}