{"parse":{"text":"<i class=\"Cyrl form-of lang-ru inf-form-of\">слу́шать</i>\n<i class=\"Cyrl form-of lang-ru pres&#124;act&#124;part-form-of\">слу́шающий</i>\n<i class=\"Cyrl form-of lang-ru past&#124;act&#124;part-form-of\">слу́шавший</i>\n<i class=\"Cyrl form-of lang-ru pres&#124;pass&#124;part-form-of\">слу́шаемый</i>\n<i class=\"Cyrl form-of lang-ru past&#124;pass&#124;part-form-of\">слу́шанный</i>\n<i class=\"Cyrl form-of lang-ru pres&#124;adv&#124;part-form-of\">слу́шая</i>\n<i class=\"Cyrl form-of lang-ru past&#124;adv&#124;part-form-of\">слу́шав</i>\n<i class=\"Cyrl form-of lang-ru 1&#124;s&#124;pres&#124;ind-form-of\">слу́шаю</i>\n<i class=\"Cyrl form-of lang-ru 2&#124;s&#124;pres&#124;ind-form-of\">слу́шаешь</i>\n<i class=\"Cyrl form-of lang-ru 3&#124;s&#124;pres&#124;ind-form-of\">слу́шает</i>\n<i class=\"Cyrl form-of lang-ru 1&#124;p&#124;pres&#124;ind-form-of\">слу́шаем</i>\n<i class=\"Cyrl form-of lang-ru 2&#124;p&#124;pres&#124;ind-form-of\">слу́шаете</i>\n<i class=\"Cyrl form-of lang-ru 3&#124;p&#124;pres&#124;ind-form-of\">слу́шают</i>\n<i class=\"Cyrl form-of lang-ru 2&#124;s&#124;imp-form-of\">слу́шай</i>\n<i class=\"Cyrl form-of lang-ru 2&#124;p&#124;imp-form-of\">слу́шайте</i>\n<i class=\"Cyrl form-of lang-ru m&#124;s&#124;past&#124;ind-form-of\">слу́шал</i>\n<i class=\"Cyrl form-of lang-ru p&#124;past&#124;ind-form-of\">слу́шали</i>\n<i class=\"Cyrl form-of lang-ru f&#124;s&#124;past&#124;ind-form-of\">слу́шала</i>\n<i class=\"Cyrl form-of lang-ru n&#124;s&#124;past&#124;ind-form-of\">слу́шало</i>\n<abbr title=\"imperfective aspect\">\nindeclinable"}}