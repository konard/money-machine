{"parse":{"text":"<i class=\"Cyrl form-of lang-ru inf-form-of\">восхища́ть</i>\n<i class=\"Cyrl form-of lang-ru pres&#124;act&#124;part-form-of\">восхища́ющий</i>\n<i class=\"Cyrl form-of lang-ru past&#124;act&#124;part-form-of\">восхища́вший</i>\n<i class=\"Cyrl form-of lang-ru pres&#124;pass&#124;part-form-of\">восхища́емый</i>\n<i class=\"Cyrl form-of lang-ru pres&#124;adv&#124;part-form-of\">восхища́я</i>\n<i class=\"Cyrl form-of lang-ru past&#124;adv&#124;part-form-of\">восхища́в</i>\n<i class=\"Cyrl form-of lang-ru 1&#124;s&#124;pres&#124;ind-form-of\">восхища́ю</i>\n<i class=\"Cyrl form-of lang-ru 2&#124;s&#124;pres&#124;ind-form-of\">восхища́ешь</i>\n<i class=\"Cyrl form-of lang-ru 3&#124;s&#124;pres&#124;ind-form-of\">восхища́ет</i>\n<i class=\"Cyrl form-of lang-ru 1&#124;p&#124;pres&#124;ind-form-of\">восхища́ем</i>\n<i class=\"Cyrl form-of lang-ru 2&#124;p&#124;pres&#124;ind-form-of\">восхища́ете</i>\n<i class=\"Cyrl form-of lang-ru 3&#124;p&#124;pres&#124;ind-form-of\">восхища́ют</i>\n<i class=\"Cyrl form-of lang-ru 2&#124;s&#124;imp-form-of\">восхища́й</i>\n<i class=\"Cyrl form-of lang-ru 2&#124;p&#124;imp-form-of\">восхища́йте</i>\n<i class=\"Cyrl form-of lang-ru m&#124;s&#124;past&#124;ind-form-of\">восхища́л</i>\n<i class=\"Cyrl form-of lang-ru p&#124;past&#124;ind-form-of\">восхища́ли</i>\n<i class=\"Cyrl form-of lang-ru f&#124;s&#124;past&#124;ind-form-of\">восхища́ла</i>\n<i class=\"Cyrl form-of lang-ru n&#124;s&#124;past&#124;ind-form-of\">восхища́ло</i>\n<abbr title=\"imperfective aspect\">\nindeclinable"}}