{"parse":{"text":"<i class=\"Cyrl form-of lang-ru inf-form-of\">подсчи́тывать</i>\n<i class=\"Cyrl form-of lang-ru pres&#124;act&#124;part-form-of\">подсчи́тывающий</i>\n<i class=\"Cyrl form-of lang-ru past&#124;act&#124;part-form-of\">подсчи́тывавший</i>\n<i class=\"Cyrl form-of lang-ru pres&#124;pass&#124;part-form-of\">подсчи́тываемый</i>\n<i class=\"Cyrl form-of lang-ru pres&#124;adv&#124;part-form-of\">подсчи́тывая</i>\n<i class=\"Cyrl form-of lang-ru past&#124;adv&#124;part-form-of\">подсчи́тывав</i>\n<i class=\"Cyrl form-of lang-ru 1&#124;s&#124;pres&#124;ind-form-of\">подсчи́тываю</i>\n<i class=\"Cyrl form-of lang-ru 2&#124;s&#124;pres&#124;ind-form-of\">подсчи́тываешь</i>\n<i class=\"Cyrl form-of lang-ru 3&#124;s&#124;pres&#124;ind-form-of\">подсчи́тывает</i>\n<i class=\"Cyrl form-of lang-ru 1&#124;p&#124;pres&#124;ind-form-of\">подсчи́тываем</i>\n<i class=\"Cyrl form-of lang-ru 2&#124;p&#124;pres&#124;ind-form-of\">подсчи́тываете</i>\n<i class=\"Cyrl form-of lang-ru 3&#124;p&#124;pres&#124;ind-form-of\">подсчи́тывают</i>\n<i class=\"Cyrl form-of lang-ru 2&#124;s&#124;imp-form-of\">подсчи́тывай</i>\n<i class=\"Cyrl form-of lang-ru 2&#124;p&#124;imp-form-of\">подсчи́тывайте</i>\n<i class=\"Cyrl form-of lang-ru m&#124;s&#124;past&#124;ind-form-of\">подсчи́тывал</i>\n<i class=\"Cyrl form-of lang-ru p&#124;past&#124;ind-form-of\">подсчи́тывали</i>\n<i class=\"Cyrl form-of lang-ru f&#124;s&#124;past&#124;ind-form-of\">подсчи́тывала</i>\n<i class=\"Cyrl form-of lang-ru n&#124;s&#124;past&#124;ind-form-of\">подсчи́тывало</i>\n<abbr title=\"imperfective aspect\">\nindeclinable"}}