{"parse":{"text":"<i class=\"Cyrl form-of lang-ru diminutive-form-of\">за́инька</i>\n<i class=\"Cyrl form-of lang-ru nom&#124;s-form-of\">за́йка</i>\n<i class=\"Cyrl form-of lang-ru nom&#124;p-form-of\">за́йки</i>\n<i class=\"Cyrl form-of lang-ru gen&#124;s-form-of\">за́йки</i>\n<i class=\"Cyrl form-of lang-ru gen&#124;p-form-of\">за́ек</i>\n<i class=\"Cyrl form-of lang-ru dat&#124;s-form-of\">за́йке</i>\n<i class=\"Cyrl form-of lang-ru dat&#124;p-form-of\">за́йкам</i>\n<i class=\"Cyrl form-of lang-ru acc&#124;s-form-of\">за́йку</i>\n<i class=\"Cyrl form-of lang-ru acc&#124;p-form-of\">за́ек</i>\n<i class=\"Cyrl form-of lang-ru ins&#124;s-form-of\">за́йкой</i>\n<i class=\"Cyrl form-of lang-ru ins&#124;p-form-of\">за́йками</i>\n<i class=\"Cyrl form-of lang-ru pre&#124;s-form-of\">за́йке</i>\n<i class=\"Cyrl form-of lang-ru pre&#124;p-form-of\">за́йках</i>\n<abbr title=\"masculine gender\">\n<abbr title=\"animate\">\n<abbr title=\"feminine gender\">\n<abbr title=\"according to the gender of the referent\">\n<a title=\"Appendix:Russian nouns\">anim fem-form velar-stem accent-a reduc</a>\n"}}