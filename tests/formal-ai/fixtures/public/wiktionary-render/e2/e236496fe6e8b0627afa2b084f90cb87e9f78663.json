{"parse":{"text":"<i class=\"Cyrl form-of lang-ru nom&#124;s-form-of\">прислу́га</i>\n<i class=\"Cyrl form-of lang-ru nom&#124;p-form-of\">прислу́ги</i>\n<i class=\"Cyrl form-of lang-ru gen&#124;s-form-of\">прислу́ги</i>\n<i class=\"Cyrl form-of lang-ru gen&#124;p-form-of\">прислу́г</i>\n<i class=\"Cyrl form-of lang-ru dat&#124;s-form-of\">прислу́ге</i>\n<i class=\"Cyrl form-of lang-ru dat&#124;p-form-of\">прислу́гам</i>\n<i class=\"Cyrl form-of lang-ru acc&#124;s-form-of\">прислу́гу</i>\n<i class=\"Cyrl form-of lang-ru acc&#124;p-form-of\">прислу́г</i>\n<i class=\"Cyrl form-of lang-ru ins&#124;s-form-of\">прислу́гой</i>\n<i class=\"Cyrl form-of lang-ru ins&#124;p-form-of\">прислу́гами</i>\n<i class=\"Cyrl form-of lang-ru pre&#124;s-form-of\">прислу́ге</i>\n<i class=\"Cyrl form-of lang-ru pre&#124;p-form-of\">прислу́гах</i>\n<abbr title=\"masculine gender\">\n<abbr title=\"animate\">\n<abbr title=\"feminine gender\">\n<abbr title=\"according to the gender of the referent\">\n<a title=\"Appendix:Russian nouns\">anim fem-form velar-stem accent-a</a>\n"}}