{"parse":{"text":"<i class=\"Cyrl form-of lang-ru nom&#124;s-form-of\">труси́шка</i>\n<i class=\"Cyrl form-of lang-ru nom&#124;p-form-of\">труси́шки</i>\n<i class=\"Cyrl form-of lang-ru gen&#124;s-form-of\">труси́шки</i>\n<i class=\"Cyrl form-of lang-ru gen&#124;p-form-of\">труси́шек</i>\n<i class=\"Cyrl form-of lang-ru dat&#124;s-form-of\">труси́шке</i>\n<i class=\"Cyrl form-of lang-ru dat&#124;p-form-of\">труси́шкам</i>\n<i class=\"Cyrl form-of lang-ru acc&#124;s-form-of\">труси́шку</i>\n<i class=\"Cyrl form-of lang-ru acc&#124;p-form-of\">труси́шек</i>\n<i class=\"Cyrl form-of lang-ru ins&#124;s-form-of\">труси́шкой</i>\n<i class=\"Cyrl form-of lang-ru ins&#124;p-form-of\">труси́шками</i>\n<i class=\"Cyrl form-of lang-ru pre&#124;s-form-of\">труси́шке</i>\n<i class=\"Cyrl form-of lang-ru pre&#124;p-form-of\">труси́шках</i>\n<abbr title=\"masculine gender\">\n<abbr title=\"animate\">\n<abbr title=\"feminine gender\">\n<abbr title=\"according to the gender of the referent\">\n<a title=\"Appendix:Russian nouns\">anim fem-form velar-stem accent-a reduc</a>\n"}}