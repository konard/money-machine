{"parse":{"text":"<i class=\"Cyrl form-of lang-ru inf-form-of\">доноси́ть</i>\n<i class=\"Cyrl form-of lang-ru pres&#124;act&#124;part-form-of\">донося́щий</i>\n<i class=\"Cyrl form-of lang-ru past&#124;act&#124;part-form-of\">доноси́вший</i>\n<i class=\"Cyrl form-of lang-ru pres&#124;pass&#124;part-form-of\">доноси́мый</i>\n<i class=\"Cyrl form-of lang-ru pres&#124;adv&#124;part-form-of\">донося́</i>\n<i class=\"Cyrl form-of lang-ru past&#124;adv&#124;part-form-of\">доноси́в</i>\n<i class=\"Cyrl form-of lang-ru 1&#124;s&#124;pres&#124;ind-form-of\">доношу́</i>\n<i class=\"Cyrl form-of lang-ru 2&#124;s&#124;pres&#124;ind-form-of\">доно́сишь</i>\n<i class=\"Cyrl form-of lang-ru 3&#124;s&#124;pres&#124;ind-form-of\">доно́сит</i>\n<i class=\"Cyrl form-of lang-ru 1&#124;p&#124;pres&#124;ind-form-of\">доно́сим</i>\n<i class=\"Cyrl form-of lang-ru 2&#124;p&#124;pres&#124;ind-form-of\">доно́сите</i>\n<i class=\"Cyrl form-of lang-ru 3&#124;p&#124;pres&#124;ind-form-of\">доно́сят</i>\n<i class=\"Cyrl form-of lang-ru 2&#124;s&#124;imp-form-of\">доноси́</i>\n<i class=\"Cyrl form-of lang-ru 2&#124;p&#124;imp-form-of\">доноси́те</i>\n<i class=\"Cyrl form-of lang-ru m&#124;s&#124;past&#124;ind-form-of\">доноси́л</i>\n<i class=\"Cyrl form-of lang-ru p&#124;past&#124;ind-form-of\">доноси́ли</i>\n<i class=\"Cyrl form-of lang-ru f&#124;s&#124;past&#124;ind-form-of\">доноси́ла</i>\n<i class=\"Cyrl form-of lang-ru n&#124;s&#124;past&#124;ind-form-of\">доноси́ло</i>\n<abbr title=\"imperfective aspect\">\nindeclinable"}}