{"parse":{"text":"<i class=\"Cyrl form-of lang-ru diminutive-form-of\">кружо́к</i>\n<i class=\"Cyrl form-of lang-ru nom&#124;s-form-of\">кру́г</i>\n<i class=\"Cyrl form-of lang-ru nom&#124;p-form-of\">круги́</i>\n<i class=\"Cyrl form-of lang-ru gen&#124;s-form-of\">кру́га</i>\n<i class=\"Cyrl form-of lang-ru gen&#124;p-form-of\">круго́в</i>\n<i class=\"Cyrl form-of lang-ru dat&#124;s-form-of\">кру́гу</i>\n<i class=\"Cyrl form-of lang-ru dat&#124;p-form-of\">круга́м</i>\n<i class=\"Cyrl form-of lang-ru acc&#124;s-form-of\">кру́г</i>\n<i class=\"Cyrl form-of lang-ru acc&#124;p-form-of\">круги́</i>\n<i class=\"Cyrl form-of lang-ru ins&#124;s-form-of\">кру́гом</i>\n<i class=\"Cyrl form-of lang-ru ins&#124;p-form-of\">круга́ми</i>\n<i class=\"Cyrl form-of lang-ru pre&#124;s-form-of\">кру́ге</i>\n<i class=\"Cyrl form-of lang-ru pre&#124;p-form-of\">круга́х</i>\n<i class=\"Cyrl form-of lang-ru loc&#124;s-form-of\">кругу́</i>\n<abbr title=\"masculine gender\">\n<abbr title=\"inanimate\">\n<a title=\"Appendix:Russian nouns\">inan masc-form velar-stem accent-c</a>\n"}}