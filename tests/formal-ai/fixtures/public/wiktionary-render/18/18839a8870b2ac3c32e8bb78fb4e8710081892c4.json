{"parse":{"text":"<i class=\"Cyrl form-of lang-ru inf-form-of\">включи́ть</i>\n<i class=\"Cyrl form-of lang-ru past&#124;act&#124;part-form-of\">включи́вший</i>\n<i class=\"Cyrl form-of lang-ru past&#124;pass&#124;part-form-of\">включённый</i>\n<i class=\"Cyrl form-of lang-ru past&#124;adv&#124;part-form-of\">включи́в</i>\n<i class=\"Cyrl form-of lang-ru 1&#124;s&#124;fut&#124;ind-form-of\">включу́</i>\n<i class=\"Cyrl form-of lang-ru 2&#124;s&#124;fut&#124;ind-form-of\">включи́шь</i>\n<i class=\"Cyrl form-of lang-ru 3&#124;s&#124;fut&#124;ind-form-of\">включи́т</i>\n<i class=\"Cyrl form-of lang-ru 1&#124;p&#124;fut&#124;ind-form-of\">включи́м</i>\n<i class=\"Cyrl form-of lang-ru 2&#124;p&#124;fut&#124;ind-form-of\">включи́те</i>\n<i class=\"Cyrl form-of lang-ru 3&#124;p&#124;fut&#124;ind-form-of\">включа́т</i>\n<i class=\"Cyrl form-of lang-ru 2&#124;s&#124;imp-form-of\">включи́</i>\n<i class=\"Cyrl form-of lang-ru 2&#124;p&#124;imp-form-of\">включи́те</i>\n<i class=\"Cyrl form-of lang-ru m&#124;s&#124;past&#124;ind-form-of\">включи́л</i>\n<i class=\"Cyrl form-of lang-ru p&#124;past&#124;ind-form-of\">включи́ли</i>\n<i class=\"Cyrl form-of lang-ru f&#124;s&#124;past&#124;ind-form-of\">включи́ла</i>\n<i class=\"Cyrl form-of lang-ru n&#124;s&#124;past&#124;ind-form-of\">включи́ло</i>\n<abbr title=\"perfective aspect\">\nindeclinable"}}