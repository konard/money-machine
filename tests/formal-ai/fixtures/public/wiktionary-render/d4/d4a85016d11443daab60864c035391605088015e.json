{"parse":{"text":"<i class=\"Cyrl form-of lang-ru inf-form-of\">свя́зываться</i>\n<i class=\"Cyrl form-of lang-ru pres&#124;act&#124;part-form-of\">свя́зывающийся</i>\n<i class=\"Cyrl form-of lang-ru past&#124;act&#124;part-form-of\">свя́зывавшийся</i>\n<i class=\"Cyrl form-of lang-ru pres&#124;adv&#124;part-form-of\">свя́зываясь</i>\n<i class=\"Cyrl form-of lang-ru past&#124;adv&#124;part-form-of\">свя́зывавшись</i>\n<i class=\"Cyrl form-of lang-ru 1&#124;s&#124;pres&#124;ind-form-of\">свя́зываюсь</i>\n<i class=\"Cyrl form-of lang-ru 2&#124;s&#124;pres&#124;ind-form-of\">свя́зываешься</i>\n<i class=\"Cyrl form-of lang-ru 3&#124;s&#124;pres&#124;ind-form-of\">свя́зывается</i>\n<i class=\"Cyrl form-of lang-ru 1&#124;p&#124;pres&#124;ind-form-of\">свя́зываемся</i>\n<i class=\"Cyrl form-of lang-ru 2&#124;p&#124;pres&#124;ind-form-of\">свя́зываетесь</i>\n<i class=\"Cyrl form-of lang-ru 3&#124;p&#124;pres&#124;ind-form-of\">свя́зываются</i>\n<i class=\"Cyrl form-of lang-ru 2&#124;s&#124;imp-form-of\">свя́зывайся</i>\n<i class=\"Cyrl form-of lang-ru 2&#124;p&#124;imp-form-of\">свя́зывайтесь</i>\n<i class=\"Cyrl form-of lang-ru m&#124;s&#124;past&#124;ind-form-of\">свя́зывался</i>\n<i class=\"Cyrl form-of lang-ru p&#124;past&#124;ind-form-of\">свя́зывались</i>\n<i class=\"Cyrl form-of lang-ru f&#124;s&#124;past&#124;ind-form-of\">свя́зывалась</i>\n<i class=\"Cyrl form-of lang-ru n&#124;s&#124;past&#124;ind-form-of\">свя́зывалось</i>\n<abbr title=\"imperfective aspect\">\nindeclinable"}}