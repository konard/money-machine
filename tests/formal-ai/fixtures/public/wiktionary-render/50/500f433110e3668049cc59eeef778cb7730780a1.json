{"parse":{"text":"<i class=\"Cyrl form-of lang-ru nom&#124;s-form-of\">пара́граф</i>\n<i class=\"Cyrl form-of lang-ru nom&#124;p-form-of\">пара́графы</i>\n<i class=\"Cyrl form-of lang-ru gen&#124;s-form-of\">пара́графа</i>\n<i class=\"Cyrl form-of lang-ru gen&#124;p-form-of\">пара́графов</i>\n<i class=\"Cyrl form-of lang-ru dat&#124;s-form-of\">пара́графу</i>\n<i class=\"Cyrl form-of lang-ru dat&#124;p-form-of\">пара́графам</i>\n<i class=\"Cyrl form-of lang-ru acc&#124;s-form-of\">пара́граф</i>\n<i class=\"Cyrl form-of lang-ru acc&#124;p-form-of\">пара́графы</i>\n<i class=\"Cyrl form-of lang-ru ins&#124;s-form-of\">пара́графом</i>\n<i class=\"Cyrl form-of lang-ru ins&#124;p-form-of\">пара́графами</i>\n<i class=\"Cyrl form-of lang-ru pre&#124;s-form-of\">пара́графе</i>\n<i class=\"Cyrl form-of lang-ru pre&#124;p-form-of\">пара́графах</i>\n<abbr title=\"masculine gender\">\n<abbr title=\"inanimate\">\n<a title=\"Appendix:Russian nouns\">inan masc-form hard-stem accent-a</a>\n"}}