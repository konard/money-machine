{"parse":{"text":"<i class=\"Cyrl form-of lang-ru diminutive-form-of\">пече́нька</i>\n<i class=\"Cyrl form-of lang-ru expressive&#95;term-form-of\">печеню́ха</i>\n<i class=\"Cyrl form-of lang-ru nom&#124;s-form-of\">пече́нье</i>\n<i class=\"Cyrl form-of lang-ru nom&#124;p-form-of\">пече́нья</i>\n<i class=\"Cyrl form-of lang-ru gen&#124;s-form-of\">пече́нья</i>\n<i class=\"Cyrl form-of lang-ru gen&#124;p-form-of\">пече́ний</i>\n<i class=\"Cyrl form-of lang-ru dat&#124;s-form-of\">пече́нью</i>\n<i class=\"Cyrl form-of lang-ru dat&#124;p-form-of\">пече́ньям</i>\n<i class=\"Cyrl form-of lang-ru acc&#124;s-form-of\">пече́нье</i>\n<i class=\"Cyrl form-of lang-ru acc&#124;p-form-of\">пече́нья</i>\n<i class=\"Cyrl form-of lang-ru ins&#124;s-form-of\">пече́ньем</i>\n<i class=\"Cyrl form-of lang-ru ins&#124;p-form-of\">пече́ньями</i>\n<i class=\"Cyrl form-of lang-ru pre&#124;s-form-of\">пече́нье</i>\n<i class=\"Cyrl form-of lang-ru pre&#124;p-form-of\">пече́ньях</i>\n<abbr title=\"neuter gender\">\n<abbr title=\"inanimate\">\n<a title=\"Appendix:Russian nouns\">inan neut-form vowel-stem accent-a</a>\n"}}