{"parse":{"text":"<i class=\"Cyrl form-of lang-ru nom&#124;s-form-of\">проже́ктор</i>\n<i class=\"Cyrl form-of lang-ru nom&#124;p-form-of\">проже́кторы</i>\n<i class=\"Cyrl form-of lang-ru gen&#124;s-form-of\">проже́ктора</i>\n<i class=\"Cyrl form-of lang-ru gen&#124;p-form-of\">проже́кторов</i>\n<i class=\"Cyrl form-of lang-ru dat&#124;s-form-of\">проже́ктору</i>\n<i class=\"Cyrl form-of lang-ru dat&#124;p-form-of\">проже́кторам</i>\n<i class=\"Cyrl form-of lang-ru acc&#124;s-form-of\">проже́ктор</i>\n<i class=\"Cyrl form-of lang-ru acc&#124;p-form-of\">проже́кторы</i>\n<i class=\"Cyrl form-of lang-ru ins&#124;s-form-of\">проже́ктором</i>\n<i class=\"Cyrl form-of lang-ru ins&#124;p-form-of\">проже́кторами</i>\n<i class=\"Cyrl form-of lang-ru pre&#124;s-form-of\">проже́кторе</i>\n<i class=\"Cyrl form-of lang-ru pre&#124;p-form-of\">проже́кторах</i>\n<abbr title=\"masculine gender\">\n<abbr title=\"inanimate\">\n<a title=\"Appendix:Russian nouns\">inan masc-form hard-stem accent-a/c irreg</a>\n"}}