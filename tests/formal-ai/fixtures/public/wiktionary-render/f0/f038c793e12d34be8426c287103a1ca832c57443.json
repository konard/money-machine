{"parse":{"text":"<i class=\"Cyrl form-of lang-ru nom&#124;s-form-of\">припа́док</i>\n<i class=\"Cyrl form-of lang-ru nom&#124;p-form-of\">припа́дки</i>\n<i class=\"Cyrl form-of lang-ru gen&#124;s-form-of\">припа́дка</i>\n<i class=\"Cyrl form-of lang-ru gen&#124;p-form-of\">припа́дков</i>\n<i class=\"Cyrl form-of lang-ru dat&#124;s-form-of\">припа́дку</i>\n<i class=\"Cyrl form-of lang-ru dat&#124;p-form-of\">припа́дкам</i>\n<i class=\"Cyrl form-of lang-ru acc&#124;s-form-of\">припа́док</i>\n<i class=\"Cyrl form-of lang-ru acc&#124;p-form-of\">припа́дки</i>\n<i class=\"Cyrl form-of lang-ru ins&#124;s-form-of\">припа́дком</i>\n<i class=\"Cyrl form-of lang-ru ins&#124;p-form-of\">припа́дками</i>\n<i class=\"Cyrl form-of lang-ru pre&#124;s-form-of\">припа́дке</i>\n<i class=\"Cyrl form-of lang-ru pre&#124;p-form-of\">припа́дках</i>\n<abbr title=\"masculine gender\">\n<abbr title=\"inanimate\">\n<a title=\"Appendix:Russian nouns\">inan masc-form velar-stem accent-a reduc</a>\n"}}