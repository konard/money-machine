{"parse":{"text":"<i class=\"Cyrl form-of lang-ru verbal&#95;noun-form-of\">пропи́тывание</i>\n<i class=\"Cyrl form-of lang-ru inf-form-of\">пропи́тывать</i>\n<i class=\"Cyrl form-of lang-ru pres&#124;act&#124;part-form-of\">пропи́тывающий</i>\n<i class=\"Cyrl form-of lang-ru past&#124;act&#124;part-form-of\">пропи́тывавший</i>\n<i class=\"Cyrl form-of lang-ru pres&#124;pass&#124;part-form-of\">пропи́тываемый</i>\n<i class=\"Cyrl form-of lang-ru pres&#124;adv&#124;part-form-of\">пропи́тывая</i>\n<i class=\"Cyrl form-of lang-ru past&#124;adv&#124;part-form-of\">пропи́тывав</i>\n<i class=\"Cyrl form-of lang-ru 1&#124;s&#124;pres&#124;ind-form-of\">пропи́тываю</i>\n<i class=\"Cyrl form-of lang-ru 2&#124;s&#124;pres&#124;ind-form-of\">пропи́тываешь</i>\n<i class=\"Cyrl form-of lang-ru 3&#124;s&#124;pres&#124;ind-form-of\">пропи́тывает</i>\n<i class=\"Cyrl form-of lang-ru 1&#124;p&#124;pres&#124;ind-form-of\">пропи́тываем</i>\n<i class=\"Cyrl form-of lang-ru 2&#124;p&#124;pres&#124;ind-form-of\">пропи́тываете</i>\n<i class=\"Cyrl form-of lang-ru 3&#124;p&#124;pres&#124;ind-form-of\">пропи́тывают</i>\n<i class=\"Cyrl form-of lang-ru 2&#124;s&#124;imp-form-of\">пропи́тывай</i>\n<i class=\"Cyrl form-of lang-ru 2&#124;p&#124;imp-form-of\">пропи́тывайте</i>\n<i class=\"Cyrl form-of lang-ru m&#124;s&#124;past&#124;ind-form-of\">пропи́тывал</i>\n<i class=\"Cyrl form-of lang-ru p&#124;past&#124;ind-form-of\">пропи́тывали</i>\n<i class=\"Cyrl form-of lang-ru f&#124;s&#124;past&#124;ind-form-of\">пропи́тывала</i>\n<i class=\"Cyrl form-of lang-ru n&#124;s&#124;past&#124;ind-form-of\">пропи́тывало</i>\n<abbr title=\"imperfective aspect\">\nindeclinable"}}