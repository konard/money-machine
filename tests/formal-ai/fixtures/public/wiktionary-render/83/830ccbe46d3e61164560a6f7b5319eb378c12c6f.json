{"parse":{"text":"<i class=\"Cyrl form-of lang-ru inf-form-of\">спроси́ть</i>\n<i class=\"Cyrl form-of lang-ru past&#124;act&#124;part-form-of\">спроси́вший</i>\n<i class=\"Cyrl form-of lang-ru past&#124;pass&#124;part-form-of\">спро́шенный</i>\n<i class=\"Cyrl form-of lang-ru past&#124;adv&#124;part-form-of\">спроси́в</i>\n<i class=\"Cyrl form-of lang-ru 1&#124;s&#124;fut&#124;ind-form-of\">спрошу́</i>\n<i class=\"Cyrl form-of lang-ru 2&#124;s&#124;fut&#124;ind-form-of\">спро́сишь</i>\n<i class=\"Cyrl form-of lang-ru 3&#124;s&#124;fut&#124;ind-form-of\">спро́сит</i>\n<i class=\"Cyrl form-of lang-ru 1&#124;p&#124;fut&#124;ind-form-of\">спро́сим</i>\n<i class=\"Cyrl form-of lang-ru 2&#124;p&#124;fut&#124;ind-form-of\">спро́сите</i>\n<i class=\"Cyrl form-of lang-ru 3&#124;p&#124;fut&#124;ind-form-of\">спро́сят</i>\n<i class=\"Cyrl form-of lang-ru 2&#124;s&#124;imp-form-of\">спроси́</i>\n<i class=\"Cyrl form-of lang-ru 2&#124;p&#124;imp-form-of\">спроси́те</i>\n<i class=\"Cyrl form-of lang-ru m&#124;s&#124;past&#124;ind-form-of\">спроси́л</i>\n<i class=\"Cyrl form-of lang-ru p&#124;past&#124;ind-form-of\">спроси́ли</i>\n<i class=\"Cyrl form-of lang-ru f&#124;s&#124;past&#124;ind-form-of\">спроси́ла</i>\n<i class=\"Cyrl form-of lang-ru n&#124;s&#124;past&#124;ind-form-of\">спроси́ло</i>\n<abbr title=\"perfective aspect\">\nindeclinable"}}