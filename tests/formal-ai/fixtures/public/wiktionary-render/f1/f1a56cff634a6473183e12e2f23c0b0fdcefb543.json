{"parse":{"text":"<i class=\"Cyrl form-of lang-ru inf-form-of\">вмести́ть</i>\n<i class=\"Cyrl form-of lang-ru past&#124;act&#124;part-form-of\">вмести́вший</i>\n<i class=\"Cyrl form-of lang-ru past&#124;pass&#124;part-form-of\">вмещённый</i>\n<i class=\"Cyrl form-of lang-ru past&#124;adv&#124;part-form-of\">вмести́в</i>\n<i class=\"Cyrl form-of lang-ru 1&#124;s&#124;fut&#124;ind-form-of\">вмещу́</i>\n<i class=\"Cyrl form-of lang-ru 2&#124;s&#124;fut&#124;ind-form-of\">вмести́шь</i>\n<i class=\"Cyrl form-of lang-ru 3&#124;s&#124;fut&#124;ind-form-of\">вмести́т</i>\n<i class=\"Cyrl form-of lang-ru 1&#124;p&#124;fut&#124;ind-form-of\">вмести́м</i>\n<i class=\"Cyrl form-of lang-ru 2&#124;p&#124;fut&#124;ind-form-of\">вмести́те</i>\n<i class=\"Cyrl form-of lang-ru 3&#124;p&#124;fut&#124;ind-form-of\">вместя́т</i>\n<i class=\"Cyrl form-of lang-ru 2&#124;s&#124;imp-form-of\">вмести́</i>\n<i class=\"Cyrl form-of lang-ru 2&#124;p&#124;imp-form-of\">вмести́те</i>\n<i class=\"Cyrl form-of lang-ru m&#124;s&#124;past&#124;ind-form-of\">вмести́л</i>\n<i class=\"Cyrl form-of lang-ru p&#124;past&#124;ind-form-of\">вмести́ли</i>\n<i class=\"Cyrl form-of lang-ru f&#124;s&#124;past&#124;ind-form-of\">вмести́ла</i>\n<i class=\"Cyrl form-of lang-ru n&#124;s&#124;past&#124;ind-form-of\">вмести́ло</i>\n<abbr title=\"perfective aspect\">\nindeclinable"}}