{"parse":{"text":"<i class=\"Cyrl form-of lang-ru inf-form-of\">наску́чить</i>\n<i class=\"Cyrl form-of lang-ru past&#124;act&#124;part-form-of\">наску́чивший</i>\n<i class=\"Cyrl form-of lang-ru past&#124;adv&#124;part-form-of\">наску́чив</i>\n<i class=\"Cyrl form-of lang-ru 1&#124;s&#124;fut&#124;ind-form-of\">наску́чу</i>\n<i class=\"Cyrl form-of lang-ru 2&#124;s&#124;fut&#124;ind-form-of\">наску́чишь</i>\n<i class=\"Cyrl form-of lang-ru 3&#124;s&#124;fut&#124;ind-form-of\">наску́чит</i>\n<i class=\"Cyrl form-of lang-ru 1&#124;p&#124;fut&#124;ind-form-of\">наску́чим</i>\n<i class=\"Cyrl form-of lang-ru 2&#124;p&#124;fut&#124;ind-form-of\">наску́чите</i>\n<i class=\"Cyrl form-of lang-ru 3&#124;p&#124;fut&#124;ind-form-of\">наску́чат</i>\n<i class=\"Cyrl form-of lang-ru 2&#124;s&#124;imp-form-of\">наску́чь</i>\n<i class=\"Cyrl form-of lang-ru 2&#124;p&#124;imp-form-of\">наску́чьте</i>\n<i class=\"Cyrl form-of lang-ru m&#124;s&#124;past&#124;ind-form-of\">наску́чил</i>\n<i class=\"Cyrl form-of lang-ru p&#124;past&#124;ind-form-of\">наску́чили</i>\n<i class=\"Cyrl form-of lang-ru f&#124;s&#124;past&#124;ind-form-of\">наску́чила</i>\n<i class=\"Cyrl form-of lang-ru n&#124;s&#124;past&#124;ind-form-of\">наску́чило</i>\n<abbr title=\"perfective aspect\">\nindeclinable"}}