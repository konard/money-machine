{"parse":{"text":"<i class=\"Cyrl form-of lang-ru diminutive-form-of\">крючо́к</i>\n<i class=\"Cyrl form-of lang-ru nom&#124;s-form-of\">крю́к</i>\n<i class=\"Cyrl form-of lang-ru nom&#124;p-form-of\">крюки́</i>\n<i class=\"Cyrl form-of lang-ru gen&#124;s-form-of\">крюка́</i>\n<i class=\"Cyrl form-of lang-ru gen&#124;p-form-of\">крюко́в</i>\n<i class=\"Cyrl form-of lang-ru dat&#124;s-form-of\">крюку́</i>\n<i class=\"Cyrl form-of lang-ru dat&#124;p-form-of\">крюка́м</i>\n<i class=\"Cyrl form-of lang-ru acc&#124;s-form-of\">крю́к</i>\n<i class=\"Cyrl form-of lang-ru acc&#124;p-form-of\">крюки́</i>\n<i class=\"Cyrl form-of lang-ru ins&#124;s-form-of\">крюко́м</i>\n<i class=\"Cyrl form-of lang-ru ins&#124;p-form-of\">крюка́ми</i>\n<i class=\"Cyrl form-of lang-ru pre&#124;s-form-of\">крюке́</i>\n<i class=\"Cyrl form-of lang-ru pre&#124;p-form-of\">крюка́х</i>\n<i class=\"Cyrl form-of lang-ru loc&#124;s-form-of\">крюку́</i>\n<abbr title=\"masculine gender\">\n<abbr title=\"inanimate\">\n<a title=\"Appendix:Russian nouns\">inan masc-form velar-stem accent-b/d irreg</a>\n"}}