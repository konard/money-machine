{"parse":{"text":"<i class=\"Cyrl form-of lang-ru inf-form-of\">выводи́ть</i>\n<i class=\"Cyrl form-of lang-ru pres&#124;act&#124;part-form-of\">выводя́щий</i>\n<i class=\"Cyrl form-of lang-ru past&#124;act&#124;part-form-of\">выводи́вший</i>\n<i class=\"Cyrl form-of lang-ru pres&#124;pass&#124;part-form-of\">выводи́мый</i>\n<i class=\"Cyrl form-of lang-ru pres&#124;adv&#124;part-form-of\">выводя́</i>\n<i class=\"Cyrl form-of lang-ru past&#124;adv&#124;part-form-of\">выводи́в</i>\n<i class=\"Cyrl form-of lang-ru 1&#124;s&#124;pres&#124;ind-form-of\">вывожу́</i>\n<i class=\"Cyrl form-of lang-ru 2&#124;s&#124;pres&#124;ind-form-of\">выво́дишь</i>\n<i class=\"Cyrl form-of lang-ru 3&#124;s&#124;pres&#124;ind-form-of\">выво́дит</i>\n<i class=\"Cyrl form-of lang-ru 1&#124;p&#124;pres&#124;ind-form-of\">выво́дим</i>\n<i class=\"Cyrl form-of lang-ru 2&#124;p&#124;pres&#124;ind-form-of\">выво́дите</i>\n<i class=\"Cyrl form-of lang-ru 3&#124;p&#124;pres&#124;ind-form-of\">выво́дят</i>\n<i class=\"Cyrl form-of lang-ru 2&#124;s&#124;imp-form-of\">выводи́</i>\n<i class=\"Cyrl form-of lang-ru 2&#124;p&#124;imp-form-of\">выводи́те</i>\n<i class=\"Cyrl form-of lang-ru m&#124;s&#124;past&#124;ind-form-of\">выводи́л</i>\n<i class=\"Cyrl form-of lang-ru p&#124;past&#124;ind-form-of\">выводи́ли</i>\n<i class=\"Cyrl form-of lang-ru f&#124;s&#124;past&#124;ind-form-of\">выводи́ла</i>\n<i class=\"Cyrl form-of lang-ru n&#124;s&#124;past&#124;ind-form-of\">выводи́ло</i>\n<abbr title=\"imperfective aspect\">\nindeclinable"}}