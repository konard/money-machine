{"parse":{"text":"<i class=\"Cyrl form-of lang-ru verbal&#95;adjective-form-of\">приставу́чий</i>\n<i class=\"Cyrl form-of lang-ru inf-form-of\">пристава́ть</i>\n<i class=\"Cyrl form-of lang-ru pres&#124;act&#124;part-form-of\">пристаю́щий</i>\n<i class=\"Cyrl form-of lang-ru past&#124;act&#124;part-form-of\">пристава́вший</i>\n<i class=\"Cyrl form-of lang-ru pres&#124;pass&#124;part-form-of\">пристава́емый</i>\n<i class=\"Cyrl form-of lang-ru pres&#124;adv&#124;part-form-of\">пристава́я</i>\n<i class=\"Cyrl form-of lang-ru past&#124;adv&#124;part-form-of\">пристава́в</i>\n<i class=\"Cyrl form-of lang-ru 1&#124;s&#124;pres&#124;ind-form-of\">пристаю́</i>\n<i class=\"Cyrl form-of lang-ru 2&#124;s&#124;pres&#124;ind-form-of\">пристаёшь</i>\n<i class=\"Cyrl form-of lang-ru 3&#124;s&#124;pres&#124;ind-form-of\">пристаёт</i>\n<i class=\"Cyrl form-of lang-ru 1&#124;p&#124;pres&#124;ind-form-of\">пристаём</i>\n<i class=\"Cyrl form-of lang-ru 2&#124;p&#124;pres&#124;ind-form-of\">пристаёте</i>\n<i class=\"Cyrl form-of lang-ru 3&#124;p&#124;pres&#124;ind-form-of\">пристаю́т</i>\n<i class=\"Cyrl form-of lang-ru 2&#124;s&#124;imp-form-of\">пристава́й</i>\n<i class=\"Cyrl form-of lang-ru 2&#124;p&#124;imp-form-of\">пристава́йте</i>\n<i class=\"Cyrl form-of lang-ru m&#124;s&#124;past&#124;ind-form-of\">пристава́л</i>\n<i class=\"Cyrl form-of lang-ru p&#124;past&#124;ind-form-of\">пристава́ли</i>\n<i class=\"Cyrl form-of lang-ru f&#124;s&#124;past&#124;ind-form-of\">пристава́ла</i>\n<i class=\"Cyrl form-of lang-ru n&#124;s&#124;past&#124;ind-form-of\">пристава́ло</i>\n<abbr title=\"imperfective aspect\">\nindeclinable"}}