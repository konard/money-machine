{"parse":{"text":"<i class=\"Cyrl form-of lang-ru nom&#124;s-form-of\">про́пуск</i>\n<i class=\"Cyrl form-of lang-ru nom&#124;p-form-of\">пропуска́</i>\n<i class=\"Cyrl form-of lang-ru gen&#124;s-form-of\">про́пуска</i>\n<i class=\"Cyrl form-of lang-ru gen&#124;p-form-of\">пропуско́в</i>\n<i class=\"Cyrl form-of lang-ru dat&#124;s-form-of\">про́пуску</i>\n<i class=\"Cyrl form-of lang-ru dat&#124;p-form-of\">пропуска́м</i>\n<i class=\"Cyrl form-of lang-ru acc&#124;s-form-of\">про́пуск</i>\n<i class=\"Cyrl form-of lang-ru acc&#124;p-form-of\">пропуска́</i>\n<i class=\"Cyrl form-of lang-ru ins&#124;s-form-of\">про́пуском</i>\n<i class=\"Cyrl form-of lang-ru ins&#124;p-form-of\">пропуска́ми</i>\n<i class=\"Cyrl form-of lang-ru pre&#124;s-form-of\">про́пуске</i>\n<i class=\"Cyrl form-of lang-ru pre&#124;p-form-of\">пропуска́х</i>\n<abbr title=\"masculine gender\">\n<abbr title=\"inanimate\">\n<a title=\"Appendix:Russian nouns\">inan masc-form velar-stem accent-c irreg</a>\n"}}