{"parse":{"text":"<i class=\"Cyrl form-of lang-ru inf-form-of\">возводи́ть</i>\n<i class=\"Cyrl form-of lang-ru pres&#124;act&#124;part-form-of\">возводя́щий</i>\n<i class=\"Cyrl form-of lang-ru past&#124;act&#124;part-form-of\">возводи́вший</i>\n<i class=\"Cyrl form-of lang-ru pres&#124;pass&#124;part-form-of\">возводи́мый</i>\n<i class=\"Cyrl form-of lang-ru pres&#124;adv&#124;part-form-of\">возводя́</i>\n<i class=\"Cyrl form-of lang-ru past&#124;adv&#124;part-form-of\">возводи́в</i>\n<i class=\"Cyrl form-of lang-ru 1&#124;s&#124;pres&#124;ind-form-of\">возвожу́</i>\n<i class=\"Cyrl form-of lang-ru 2&#124;s&#124;pres&#124;ind-form-of\">возво́дишь</i>\n<i class=\"Cyrl form-of lang-ru 3&#124;s&#124;pres&#124;ind-form-of\">возво́дит</i>\n<i class=\"Cyrl form-of lang-ru 1&#124;p&#124;pres&#124;ind-form-of\">возво́дим</i>\n<i class=\"Cyrl form-of lang-ru 2&#124;p&#124;pres&#124;ind-form-of\">возво́дите</i>\n<i class=\"Cyrl form-of lang-ru 3&#124;p&#124;pres&#124;ind-form-of\">возво́дят</i>\n<i class=\"Cyrl form-of lang-ru 2&#124;s&#124;imp-form-of\">возводи́</i>\n<i class=\"Cyrl form-of lang-ru 2&#124;p&#124;imp-form-of\">возводи́те</i>\n<i class=\"Cyrl form-of lang-ru m&#124;s&#124;past&#124;ind-form-of\">возводи́л</i>\n<i class=\"Cyrl form-of lang-ru p&#124;past&#124;ind-form-of\">возводи́ли</i>\n<i class=\"Cyrl form-of lang-ru f&#124;s&#124;past&#124;ind-form-of\">возводи́ла</i>\n<i class=\"Cyrl form-of lang-ru n&#124;s&#124;past&#124;ind-form-of\">возводи́ло</i>\n<abbr title=\"imperfective aspect\">\nindeclinable"}}