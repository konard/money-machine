{"parse":{"text":"<i class=\"Cyrl form-of lang-ru verbal&#95;adjective-form-of\">приставу́чий</i>\n<i class=\"Cyrl form-of lang-ru inf-form-of\">приста́ть</i>\n<i class=\"Cyrl form-of lang-ru past&#124;act&#124;part-form-of\">приста́вший</i>\n<i class=\"Cyrl form-of lang-ru past&#124;adv&#124;part-form-of\">приста́в</i>\n<i class=\"Cyrl form-of lang-ru 1&#124;s&#124;fut&#124;ind-form-of\">приста́ну</i>\n<i class=\"Cyrl form-of lang-ru 2&#124;s&#124;fut&#124;ind-form-of\">приста́нешь</i>\n<i class=\"Cyrl form-of lang-ru 3&#124;s&#124;fut&#124;ind-form-of\">приста́нет</i>\n<i class=\"Cyrl form-of lang-ru 1&#124;p&#124;fut&#124;ind-form-of\">приста́нем</i>\n<i class=\"Cyrl form-of lang-ru 2&#124;p&#124;fut&#124;ind-form-of\">приста́нете</i>\n<i class=\"Cyrl form-of lang-ru 3&#124;p&#124;fut&#124;ind-form-of\">приста́нут</i>\n<i class=\"Cyrl form-of lang-ru 2&#124;s&#124;imp-form-of\">приста́нь</i>\n<i class=\"Cyrl form-of lang-ru 2&#124;p&#124;imp-form-of\">приста́ньте</i>\n<i class=\"Cyrl form-of lang-ru m&#124;s&#124;past&#124;ind-form-of\">приста́л</i>\n<i class=\"Cyrl form-of lang-ru p&#124;past&#124;ind-form-of\">приста́ли</i>\n<i class=\"Cyrl form-of lang-ru f&#124;s&#124;past&#124;ind-form-of\">приста́ла</i>\n<i class=\"Cyrl form-of lang-ru n&#124;s&#124;past&#124;ind-form-of\">приста́ло</i>\n<abbr title=\"perfective aspect\">\nindeclinable"}}