{"parse":{"text":"<i class=\"Cyrl form-of lang-ru diminutive-form-of\">пры́щичек</i>\n<i class=\"Cyrl form-of lang-ru nom&#124;s-form-of\">пры́щик</i>\n<i class=\"Cyrl form-of lang-ru nom&#124;p-form-of\">пры́щики</i>\n<i class=\"Cyrl form-of lang-ru gen&#124;s-form-of\">пры́щика</i>\n<i class=\"Cyrl form-of lang-ru gen&#124;p-form-of\">пры́щиков</i>\n<i class=\"Cyrl form-of lang-ru dat&#124;s-form-of\">пры́щику</i>\n<i class=\"Cyrl form-of lang-ru dat&#124;p-form-of\">пры́щикам</i>\n<i class=\"Cyrl form-of lang-ru acc&#124;s-form-of\">пры́щик</i>\n<i class=\"Cyrl form-of lang-ru acc&#124;p-form-of\">пры́щики</i>\n<i class=\"Cyrl form-of lang-ru ins&#124;s-form-of\">пры́щиком</i>\n<i class=\"Cyrl form-of lang-ru ins&#124;p-form-of\">пры́щиками</i>\n<i class=\"Cyrl form-of lang-ru pre&#124;s-form-of\">пры́щике</i>\n<i class=\"Cyrl form-of lang-ru pre&#124;p-form-of\">пры́щиках</i>\n<abbr title=\"masculine gender\">\n<abbr title=\"inanimate\">\n<a title=\"Appendix:Russian nouns\">inan masc-form velar-stem accent-a</a>\n"}}