{"parse":{"text":"<i class=\"Cyrl form-of lang-ru inf-form-of\">согласо́вываться</i>\n<i class=\"Cyrl form-of lang-ru pres&#124;act&#124;part-form-of\">согласо́вывающийся</i>\n<i class=\"Cyrl form-of lang-ru past&#124;act&#124;part-form-of\">согласо́вывавшийся</i>\n<i class=\"Cyrl form-of lang-ru pres&#124;adv&#124;part-form-of\">согласо́вываясь</i>\n<i class=\"Cyrl form-of lang-ru past&#124;adv&#124;part-form-of\">согласо́вывавшись</i>\n<i class=\"Cyrl form-of lang-ru 1&#124;s&#124;pres&#124;ind-form-of\">согласо́вываюсь</i>\n<i class=\"Cyrl form-of lang-ru 2&#124;s&#124;pres&#124;ind-form-of\">согласо́вываешься</i>\n<i class=\"Cyrl form-of lang-ru 3&#124;s&#124;pres&#124;ind-form-of\">согласо́вывается</i>\n<i class=\"Cyrl form-of lang-ru 1&#124;p&#124;pres&#124;ind-form-of\">согласо́вываемся</i>\n<i class=\"Cyrl form-of lang-ru 2&#124;p&#124;pres&#124;ind-form-of\">согласо́вываетесь</i>\n<i class=\"Cyrl form-of lang-ru 3&#124;p&#124;pres&#124;ind-form-of\">согласо́вываются</i>\n<i class=\"Cyrl form-of lang-ru 2&#124;s&#124;imp-form-of\">согласо́вывайся</i>\n<i class=\"Cyrl form-of lang-ru 2&#124;p&#124;imp-form-of\">согласо́вывайтесь</i>\n<i class=\"Cyrl form-of lang-ru m&#124;s&#124;past&#124;ind-form-of\">согласо́вывался</i>\n<i class=\"Cyrl form-of lang-ru p&#124;past&#124;ind-form-of\">согласо́вывались</i>\n<i class=\"Cyrl form-of lang-ru f&#124;s&#124;past&#124;ind-form-of\">согласо́вывалась</i>\n<i class=\"Cyrl form-of lang-ru n&#124;s&#124;past&#124;ind-form-of\">согласо́вывалось</i>\n<abbr title=\"imperfective aspect\">\nindeclinable"}}