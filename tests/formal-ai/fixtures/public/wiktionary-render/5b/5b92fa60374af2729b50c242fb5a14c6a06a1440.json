{"parse":{"text":"<i class=\"Cyrl form-of lang-ru inf-form-of\">выздора́вливать</i>\n<i class=\"Cyrl form-of lang-ru pres&#124;act&#124;part-form-of\">выздора́вливающий</i>\n<i class=\"Cyrl form-of lang-ru past&#124;act&#124;part-form-of\">выздора́вливавший</i>\n<i class=\"Cyrl form-of lang-ru pres&#124;adv&#124;part-form-of\">выздора́вливая</i>\n<i class=\"Cyrl form-of lang-ru past&#124;adv&#124;part-form-of\">выздора́вливав</i>\n<i class=\"Cyrl form-of lang-ru 1&#124;s&#124;pres&#124;ind-form-of\">выздора́вливаю</i>\n<i class=\"Cyrl form-of lang-ru 2&#124;s&#124;pres&#124;ind-form-of\">выздора́вливаешь</i>\n<i class=\"Cyrl form-of lang-ru 3&#124;s&#124;pres&#124;ind-form-of\">выздора́вливает</i>\n<i class=\"Cyrl form-of lang-ru 1&#124;p&#124;pres&#124;ind-form-of\">выздора́вливаем</i>\n<i class=\"Cyrl form-of lang-ru 2&#124;p&#124;pres&#124;ind-form-of\">выздора́вливаете</i>\n<i class=\"Cyrl form-of lang-ru 3&#124;p&#124;pres&#124;ind-form-of\">выздора́вливают</i>\n<i class=\"Cyrl form-of lang-ru 2&#124;s&#124;imp-form-of\">выздора́вливай</i>\n<i class=\"Cyrl form-of lang-ru 2&#124;p&#124;imp-form-of\">выздора́вливайте</i>\n<i class=\"Cyrl form-of lang-ru m&#124;s&#124;past&#124;ind-form-of\">выздора́вливал</i>\n<i class=\"Cyrl form-of lang-ru p&#124;past&#124;ind-form-of\">выздора́вливали</i>\n<i class=\"Cyrl form-of lang-ru f&#124;s&#124;past&#124;ind-form-of\">выздора́вливала</i>\n<i class=\"Cyrl form-of lang-ru n&#124;s&#124;past&#124;ind-form-of\">выздора́вливало</i>\n<abbr title=\"imperfective aspect\">\nindeclinable"}}