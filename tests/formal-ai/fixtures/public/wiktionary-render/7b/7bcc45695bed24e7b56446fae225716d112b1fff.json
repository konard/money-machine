{"parse":{"text":"<i class=\"Cyrl form-of lang-ru verbal&#95;adjective-form-of\">пропа́щий</i>\n<i class=\"Cyrl form-of lang-ru inf-form-of\">пропа́сть</i>\n<i class=\"Cyrl form-of lang-ru past&#124;act&#124;part-form-of\">пропа́вший</i>\n<i class=\"Cyrl form-of lang-ru past&#124;adv&#124;part-form-of\">пропа́в</i>\n<i class=\"Cyrl form-of lang-ru 1&#124;s&#124;fut&#124;ind-form-of\">пропаду́</i>\n<i class=\"Cyrl form-of lang-ru 2&#124;s&#124;fut&#124;ind-form-of\">пропадёшь</i>\n<i class=\"Cyrl form-of lang-ru 3&#124;s&#124;fut&#124;ind-form-of\">пропадёт</i>\n<i class=\"Cyrl form-of lang-ru 1&#124;p&#124;fut&#124;ind-form-of\">пропадём</i>\n<i class=\"Cyrl form-of lang-ru 2&#124;p&#124;fut&#124;ind-form-of\">пропадёте</i>\n<i class=\"Cyrl form-of lang-ru 3&#124;p&#124;fut&#124;ind-form-of\">пропаду́т</i>\n<i class=\"Cyrl form-of lang-ru 2&#124;s&#124;imp-form-of\">пропади́</i>\n<i class=\"Cyrl form-of lang-ru 2&#124;p&#124;imp-form-of\">пропади́те</i>\n<i class=\"Cyrl form-of lang-ru m&#124;s&#124;past&#124;ind-form-of\">пропа́л</i>\n<i class=\"Cyrl form-of lang-ru p&#124;past&#124;ind-form-of\">пропа́ли</i>\n<i class=\"Cyrl form-of lang-ru f&#124;s&#124;past&#124;ind-form-of\">пропа́ла</i>\n<i class=\"Cyrl form-of lang-ru n&#124;s&#124;past&#124;ind-form-of\">пропа́ло</i>\n<abbr title=\"perfective aspect\">\nindeclinable"}}