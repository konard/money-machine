{"parse":{"text":"<i class=\"Cyrl form-of lang-ru diminutive-form-of\">причёсочка</i>\n<i class=\"Cyrl form-of lang-ru expressive&#95;term-form-of\">причесо́н</i>\n<i class=\"Cyrl form-of lang-ru nom&#124;s-form-of\">причёска</i>\n<i class=\"Cyrl form-of lang-ru nom&#124;p-form-of\">причёски</i>\n<i class=\"Cyrl form-of lang-ru gen&#124;s-form-of\">причёски</i>\n<i class=\"Cyrl form-of lang-ru gen&#124;p-form-of\">причёсок</i>\n<i class=\"Cyrl form-of lang-ru dat&#124;s-form-of\">причёске</i>\n<i class=\"Cyrl form-of lang-ru dat&#124;p-form-of\">причёскам</i>\n<i class=\"Cyrl form-of lang-ru acc&#124;s-form-of\">причёску</i>\n<i class=\"Cyrl form-of lang-ru acc&#124;p-form-of\">причёски</i>\n<i class=\"Cyrl form-of lang-ru ins&#124;s-form-of\">причёской</i>\n<i class=\"Cyrl form-of lang-ru ins&#124;p-form-of\">причёсками</i>\n<i class=\"Cyrl form-of lang-ru pre&#124;s-form-of\">причёске</i>\n<i class=\"Cyrl form-of lang-ru pre&#124;p-form-of\">причёсках</i>\n<abbr title=\"feminine gender\">\n<abbr title=\"inanimate\">\n<a title=\"Appendix:Russian nouns\">inan fem-form velar-stem accent-a reduc</a>\n"}}