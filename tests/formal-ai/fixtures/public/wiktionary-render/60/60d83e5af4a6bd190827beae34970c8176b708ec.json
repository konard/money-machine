{"parse":{"text":"<i class=\"Cyrl form-of lang-ru nom&#124;s-form-of\">приго́рок</i>\n<i class=\"Cyrl form-of lang-ru nom&#124;p-form-of\">приго́рки</i>\n<i class=\"Cyrl form-of lang-ru gen&#124;s-form-of\">приго́рка</i>\n<i class=\"Cyrl form-of lang-ru gen&#124;p-form-of\">приго́рков</i>\n<i class=\"Cyrl form-of lang-ru dat&#124;s-form-of\">приго́рку</i>\n<i class=\"Cyrl form-of lang-ru dat&#124;p-form-of\">приго́ркам</i>\n<i class=\"Cyrl form-of lang-ru acc&#124;s-form-of\">приго́рок</i>\n<i class=\"Cyrl form-of lang-ru acc&#124;p-form-of\">приго́рки</i>\n<i class=\"Cyrl form-of lang-ru ins&#124;s-form-of\">приго́рком</i>\n<i class=\"Cyrl form-of lang-ru ins&#124;p-form-of\">приго́рками</i>\n<i class=\"Cyrl form-of lang-ru pre&#124;s-form-of\">приго́рке</i>\n<i class=\"Cyrl form-of lang-ru pre&#124;p-form-of\">приго́рках</i>\n<abbr title=\"masculine gender\">\n<abbr title=\"inanimate\">\n<a title=\"Appendix:Russian nouns\">inan masc-form velar-stem accent-a reduc</a>\n"}}