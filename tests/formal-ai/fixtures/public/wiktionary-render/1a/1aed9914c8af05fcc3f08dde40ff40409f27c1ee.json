{"parse":{"text":"<i class=\"Cyrl form-of lang-ru inf-form-of\">здоро́ваться</i>\n<i class=\"Cyrl form-of lang-ru pres&#124;act&#124;part-form-of\">здоро́вающийся</i>\n<i class=\"Cyrl form-of lang-ru past&#124;act&#124;part-form-of\">здоро́вавшийся</i>\n<i class=\"Cyrl form-of lang-ru pres&#124;adv&#124;part-form-of\">здоро́ваясь</i>\n<i class=\"Cyrl form-of lang-ru past&#124;adv&#124;part-form-of\">здоро́вавшись</i>\n<i class=\"Cyrl form-of lang-ru 1&#124;s&#124;pres&#124;ind-form-of\">здоро́ваюсь</i>\n<i class=\"Cyrl form-of lang-ru 2&#124;s&#124;pres&#124;ind-form-of\">здоро́ваешься</i>\n<i class=\"Cyrl form-of lang-ru 3&#124;s&#124;pres&#124;ind-form-of\">здоро́вается</i>\n<i class=\"Cyrl form-of lang-ru 1&#124;p&#124;pres&#124;ind-form-of\">здоро́ваемся</i>\n<i class=\"Cyrl form-of lang-ru 2&#124;p&#124;pres&#124;ind-form-of\">здоро́ваетесь</i>\n<i class=\"Cyrl form-of lang-ru 3&#124;p&#124;pres&#124;ind-form-of\">здоро́ваются</i>\n<i class=\"Cyrl form-of lang-ru 2&#124;s&#124;imp-form-of\">здоро́вайся</i>\n<i class=\"Cyrl form-of lang-ru 2&#124;p&#124;imp-form-of\">здоро́вайтесь</i>\n<i class=\"Cyrl form-of lang-ru m&#124;s&#124;past&#124;ind-form-of\">здоро́вался</i>\n<i class=\"Cyrl form-of lang-ru p&#124;past&#124;ind-form-of\">здоро́вались</i>\n<i class=\"Cyrl form-of lang-ru f&#124;s&#124;past&#124;ind-form-of\">здоро́валась</i>\n<i class=\"Cyrl form-of lang-ru n&#124;s&#124;past&#124;ind-form-of\">здоро́валось</i>\n<abbr title=\"imperfective aspect\">\nindeclinable"}}