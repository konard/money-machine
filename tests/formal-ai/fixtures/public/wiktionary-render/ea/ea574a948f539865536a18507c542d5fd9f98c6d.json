{"parse":{"text":"<i class=\"Cyrl form-of lang-ru inf-form-of\">скита́ться</i>\n<i class=\"Cyrl form-of lang-ru pres&#124;act&#124;part-form-of\">скита́ющийся</i>\n<i class=\"Cyrl form-of lang-ru past&#124;act&#124;part-form-of\">скита́вшийся</i>\n<i class=\"Cyrl form-of lang-ru pres&#124;adv&#124;part-form-of\">скита́ясь</i>\n<i class=\"Cyrl form-of lang-ru past&#124;adv&#124;part-form-of\">скита́вшись</i>\n<i class=\"Cyrl form-of lang-ru 1&#124;s&#124;pres&#124;ind-form-of\">скита́юсь</i>\n<i class=\"Cyrl form-of lang-ru 2&#124;s&#124;pres&#124;ind-form-of\">скита́ешься</i>\n<i class=\"Cyrl form-of lang-ru 3&#124;s&#124;pres&#124;ind-form-of\">скита́ется</i>\n<i class=\"Cyrl form-of lang-ru 1&#124;p&#124;pres&#124;ind-form-of\">скита́емся</i>\n<i class=\"Cyrl form-of lang-ru 2&#124;p&#124;pres&#124;ind-form-of\">скита́етесь</i>\n<i class=\"Cyrl form-of lang-ru 3&#124;p&#124;pres&#124;ind-form-of\">скита́ются</i>\n<i class=\"Cyrl form-of lang-ru 2&#124;s&#124;imp-form-of\">скита́йся</i>\n<i class=\"Cyrl form-of lang-ru 2&#124;p&#124;imp-form-of\">скита́йтесь</i>\n<i class=\"Cyrl form-of lang-ru m&#124;s&#124;past&#124;ind-form-of\">скита́лся</i>\n<i class=\"Cyrl form-of lang-ru p&#124;past&#124;ind-form-of\">скита́лись</i>\n<i class=\"Cyrl form-of lang-ru f&#124;s&#124;past&#124;ind-form-of\">скита́лась</i>\n<i class=\"Cyrl form-of lang-ru n&#124;s&#124;past&#124;ind-form-of\">скита́лось</i>\n<abbr title=\"imperfective aspect\">\nindeclinable"}}