{"parse":{"text":"<i class=\"Cyrl form-of lang-ru inf-form-of\">преподноси́ть</i>\n<i class=\"Cyrl form-of lang-ru pres&#124;act&#124;part-form-of\">преподнося́щий</i>\n<i class=\"Cyrl form-of lang-ru past&#124;act&#124;part-form-of\">преподноси́вший</i>\n<i class=\"Cyrl form-of lang-ru pres&#124;pass&#124;part-form-of\">преподноси́мый</i>\n<i class=\"Cyrl form-of lang-ru pres&#124;adv&#124;part-form-of\">преподнося́</i>\n<i class=\"Cyrl form-of lang-ru past&#124;adv&#124;part-form-of\">преподноси́в</i>\n<i class=\"Cyrl form-of lang-ru 1&#124;s&#124;pres&#124;ind-form-of\">преподношу́</i>\n<i class=\"Cyrl form-of lang-ru 2&#124;s&#124;pres&#124;ind-form-of\">преподно́сишь</i>\n<i class=\"Cyrl form-of lang-ru 3&#124;s&#124;pres&#124;ind-form-of\">преподно́сит</i>\n<i class=\"Cyrl form-of lang-ru 1&#124;p&#124;pres&#124;ind-form-of\">преподно́сим</i>\n<i class=\"Cyrl form-of lang-ru 2&#124;p&#124;pres&#124;ind-form-of\">преподно́сите</i>\n<i class=\"Cyrl form-of lang-ru 3&#124;p&#124;pres&#124;ind-form-of\">преподно́сят</i>\n<i class=\"Cyrl form-of lang-ru 2&#124;s&#124;imp-form-of\">преподноси́</i>\n<i class=\"Cyrl form-of lang-ru 2&#124;p&#124;imp-form-of\">преподноси́те</i>\n<i class=\"Cyrl form-of lang-ru m&#124;s&#124;past&#124;ind-form-of\">преподноси́л</i>\n<i class=\"Cyrl form-of lang-ru p&#124;past&#124;ind-form-of\">преподноси́ли</i>\n<i class=\"Cyrl form-of lang-ru f&#124;s&#124;past&#124;ind-form-of\">преподноси́ла</i>\n<i class=\"Cyrl form-of lang-ru n&#124;s&#124;past&#124;ind-form-of\">преподноси́ло</i>\n<abbr title=\"imperfective aspect\">\nindeclinable"}}