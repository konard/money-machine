{"parse":{"text":"<i class=\"Cyrl form-of lang-ru diminutive-form-of\">проце́ссик</i>\n<i class=\"Cyrl form-of lang-ru nom&#124;s-form-of\">проце́сс</i>\n<i class=\"Cyrl form-of lang-ru nom&#124;p-form-of\">проце́ссы</i>\n<i class=\"Cyrl form-of lang-ru gen&#124;s-form-of\">проце́сса</i>\n<i class=\"Cyrl form-of lang-ru gen&#124;p-form-of\">проце́ссов</i>\n<i class=\"Cyrl form-of lang-ru dat&#124;s-form-of\">проце́ссу</i>\n<i class=\"Cyrl form-of lang-ru dat&#124;p-form-of\">проце́ссам</i>\n<i class=\"Cyrl form-of lang-ru acc&#124;s-form-of\">проце́сс</i>\n<i class=\"Cyrl form-of lang-ru acc&#124;p-form-of\">проце́ссы</i>\n<i class=\"Cyrl form-of lang-ru ins&#124;s-form-of\">проце́ссом</i>\n<i class=\"Cyrl form-of lang-ru ins&#124;p-form-of\">проце́ссами</i>\n<i class=\"Cyrl form-of lang-ru pre&#124;s-form-of\">проце́ссе</i>\n<i class=\"Cyrl form-of lang-ru pre&#124;p-form-of\">проце́ссах</i>\n<abbr title=\"masculine gender\">\n<abbr title=\"inanimate\">\n<a title=\"Appendix:Russian nouns\">inan masc-form hard-stem accent-a</a>\n"}}