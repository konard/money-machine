{"parse":{"text":"<i class=\"Cyrl form-of lang-ru inf-form-of\">се́сть</i>\n<i class=\"Cyrl form-of lang-ru past&#124;act&#124;part-form-of\">се́вший</i>\n<i class=\"Cyrl form-of lang-ru past&#124;adv&#124;part-form-of\">се́в</i>\n<i class=\"Cyrl form-of lang-ru 1&#124;s&#124;fut&#124;ind-form-of\">ся́ду</i>\n<i class=\"Cyrl form-of lang-ru 2&#124;s&#124;fut&#124;ind-form-of\">ся́дешь</i>\n<i class=\"Cyrl form-of lang-ru 3&#124;s&#124;fut&#124;ind-form-of\">ся́дет</i>\n<i class=\"Cyrl form-of lang-ru 1&#124;p&#124;fut&#124;ind-form-of\">ся́дем</i>\n<i class=\"Cyrl form-of lang-ru 2&#124;p&#124;fut&#124;ind-form-of\">ся́дете</i>\n<i class=\"Cyrl form-of lang-ru 3&#124;p&#124;fut&#124;ind-form-of\">ся́дут</i>\n<i class=\"Cyrl form-of lang-ru 2&#124;s&#124;imp-form-of\">ся́дь</i>\n<i class=\"Cyrl form-of lang-ru 2&#124;p&#124;imp-form-of\">ся́дьте</i>\n<i class=\"Cyrl form-of lang-ru m&#124;s&#124;past&#124;ind-form-of\">се́л</i>\n<i class=\"Cyrl form-of lang-ru p&#124;past&#124;ind-form-of\">се́ли</i>\n<i class=\"Cyrl form-of lang-ru f&#124;s&#124;past&#124;ind-form-of\">се́ла</i>\n<i class=\"Cyrl form-of lang-ru n&#124;s&#124;past&#124;ind-form-of\">се́ло</i>\n<abbr title=\"perfective aspect\">\nindeclinable"}}