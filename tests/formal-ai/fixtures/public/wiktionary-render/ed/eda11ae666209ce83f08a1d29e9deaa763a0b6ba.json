{"parse":{"text":"<i class=\"Cyrl form-of lang-ru diminutive-form-of\">го́дик</i>\n<i class=\"Cyrl form-of lang-ru nom&#124;s-form-of\">го́д</i>\n<i class=\"Cyrl form-of lang-ru nom&#124;p-form-of\">го́ды</i>\n<i class=\"Cyrl form-of lang-ru gen&#124;s-form-of\">го́да</i>\n<i class=\"Cyrl form-of lang-ru gen&#124;p-form-of\">годо́в</i>\n<i class=\"Cyrl form-of lang-ru dat&#124;s-form-of\">го́ду</i>\n<i class=\"Cyrl form-of lang-ru dat&#124;p-form-of\">года́м</i>\n<i class=\"Cyrl form-of lang-ru acc&#124;s-form-of\">го́д</i>\n<i class=\"Cyrl form-of lang-ru acc&#124;p-form-of\">го́ды</i>\n<i class=\"Cyrl form-of lang-ru ins&#124;s-form-of\">го́дом</i>\n<i class=\"Cyrl form-of lang-ru ins&#124;p-form-of\">года́ми</i>\n<i class=\"Cyrl form-of lang-ru pre&#124;s-form-of\">го́де</i>\n<i class=\"Cyrl form-of lang-ru pre&#124;p-form-of\">года́х</i>\n<i class=\"Cyrl form-of lang-ru par&#124;s-form-of\">го́ду</i>\n<abbr title=\"masculine gender\">\n<abbr title=\"inanimate\">\n<a title=\"Appendix:Russian nouns\">inan masc-form hard-stem accent-e/c irreg</a>\n"}}