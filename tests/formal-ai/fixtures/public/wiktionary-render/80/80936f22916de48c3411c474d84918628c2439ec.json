{"parse":{"text":"<i class=\"Cyrl form-of lang-ru inf-form-of\">насыща́ться</i>\n<i class=\"Cyrl form-of lang-ru pres&#124;act&#124;part-form-of\">насыща́ющийся</i>\n<i class=\"Cyrl form-of lang-ru past&#124;act&#124;part-form-of\">насыща́вшийся</i>\n<i class=\"Cyrl form-of lang-ru pres&#124;adv&#124;part-form-of\">насыща́ясь</i>\n<i class=\"Cyrl form-of lang-ru past&#124;adv&#124;part-form-of\">насыща́вшись</i>\n<i class=\"Cyrl form-of lang-ru 1&#124;s&#124;pres&#124;ind-form-of\">насыща́юсь</i>\n<i class=\"Cyrl form-of lang-ru 2&#124;s&#124;pres&#124;ind-form-of\">насыща́ешься</i>\n<i class=\"Cyrl form-of lang-ru 3&#124;s&#124;pres&#124;ind-form-of\">насыща́ется</i>\n<i class=\"Cyrl form-of lang-ru 1&#124;p&#124;pres&#124;ind-form-of\">насыща́емся</i>\n<i class=\"Cyrl form-of lang-ru 2&#124;p&#124;pres&#124;ind-form-of\">насыща́етесь</i>\n<i class=\"Cyrl form-of lang-ru 3&#124;p&#124;pres&#124;ind-form-of\">насыща́ются</i>\n<i class=\"Cyrl form-of lang-ru 2&#124;s&#124;imp-form-of\">насыща́йся</i>\n<i class=\"Cyrl form-of lang-ru 2&#124;p&#124;imp-form-of\">насыща́йтесь</i>\n<i class=\"Cyrl form-of lang-ru m&#124;s&#124;past&#124;ind-form-of\">насыща́лся</i>\n<i class=\"Cyrl form-of lang-ru p&#124;past&#124;ind-form-of\">насыща́лись</i>\n<i class=\"Cyrl form-of lang-ru f&#124;s&#124;past&#124;ind-form-of\">насыща́лась</i>\n<i class=\"Cyrl form-of lang-ru n&#124;s&#124;past&#124;ind-form-of\">насыща́лось</i>\n<abbr title=\"imperfective aspect\">\nindeclinable"}}