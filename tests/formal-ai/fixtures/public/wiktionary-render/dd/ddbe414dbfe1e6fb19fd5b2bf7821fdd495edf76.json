{"parse":{"text":"<i class=\"Cyrl form-of lang-ru diminutive-form-of\">бо́ртик</i>\n<i class=\"Cyrl form-of lang-ru nom&#124;s-form-of\">бо́рт</i>\n<i class=\"Cyrl form-of lang-ru nom&#124;p-form-of\">борта́</i>\n<i class=\"Cyrl form-of lang-ru gen&#124;s-form-of\">бо́рта</i>\n<i class=\"Cyrl form-of lang-ru gen&#124;p-form-of\">борто́в</i>\n<i class=\"Cyrl form-of lang-ru dat&#124;s-form-of\">бо́рту</i>\n<i class=\"Cyrl form-of lang-ru dat&#124;p-form-of\">борта́м</i>\n<i class=\"Cyrl form-of lang-ru acc&#124;s-form-of\">бо́рт</i>\n<i class=\"Cyrl form-of lang-ru acc&#124;p-form-of\">борта́</i>\n<i class=\"Cyrl form-of lang-ru ins&#124;s-form-of\">бо́ртом</i>\n<i class=\"Cyrl form-of lang-ru ins&#124;p-form-of\">борта́ми</i>\n<i class=\"Cyrl form-of lang-ru pre&#124;s-form-of\">бо́рте</i>\n<i class=\"Cyrl form-of lang-ru pre&#124;p-form-of\">борта́х</i>\n<abbr title=\"masculine gender\">\n<abbr title=\"inanimate\">\n<a title=\"Appendix:Russian nouns\">inan masc-form hard-stem accent-c irreg</a>\n"}}