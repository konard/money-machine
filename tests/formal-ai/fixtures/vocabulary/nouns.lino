# Noun concepts: one concept per meaning, grounded in Wikidata where the
# grounding was checked (`npm run formal-ai -- ground` fills and verifies it).
#
#   concept <id>              one link per exact meaning
#     gloss "<definition>"    what separates it from its neighbours
#     class <classes>         semantic classes used for sense selection
#     en noun <lemma> [plural]
#     ru noun <lemma> <m|f|n> [anim] [end] [plt] [indecl] [pl:a|pl:ja]
#        [stem:<stem>] [loc:<locative-2>] [at:на] [when:<instrumental>]
#     form <slot> <surface>   explicit paradigm cell, e.g. `form pl.gen людей`
#     cues <words>            nearby words that point to this meaning

concept person
  gloss "human being"
  class person
  en noun person people
  ru noun человек m anim
  form pl.nom люди
  form pl.gen людей
  form pl.dat людям
  form pl.ins людьми
  form pl.prep людях

